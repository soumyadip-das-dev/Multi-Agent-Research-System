# Multi-Agent Research System - Environment Configuration

# LLM Provider Configuration
# Supported providers: gemini, openai, mock
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Tavily Web Search API Key (Required for live web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Semantic Scholar API Key (Optional, increases rate limits for academic search)
SEMANTIC_SCHOLAR_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
